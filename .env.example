# Server-only OpenAI project key. Never prefix this with VITE_.
OPENAI_API_KEY=

# Comma-separated exact application origins accepted by the Realtime endpoints.
KB_FORM_ALLOWED_ORIGINS=http://127.0.0.1:5173

# Optional independent HMAC secret for privacy-safe IDs and signed session capabilities.
# If omitted, the server derives the HMAC from OPENAI_API_KEY.
KB_FORM_SAFETY_ID_SECRET=
