{
  "name": "kettlebellform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-model-assets.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:verify": "npm run build && node scripts/verify-build.mjs",
    "voice:master": "node scripts/master-coach-voice-pack.mjs",
    "voice:verify": "node scripts/verify-coach-voice-pack.mjs",
    "voice:runtime:check": "python3 scripts/check-coach-voice-runtime.py",
    "voice:references:check": "python3 scripts/generate-coach-voice-references.py self-check",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "verify:all": "npm run check && npm run test:e2e && npm run audit:all",
    "check": "npm run voice:runtime:check && npm run voice:verify && npm run voice:references:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build:verify"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.0",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.7.0",
    "jsdom": "29.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.9"
  },
  "overrides": {
    "brace-expansion@^5.0.0": "5.0.9",
    "nanoid@^3.0.0": "3.3.18"
  }
}
